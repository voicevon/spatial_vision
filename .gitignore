__pycache__/
*.py[cod]
*$py.class

# data 目录仅同步各工位原始图片与根配置 yaml，其余 (地图/观测/报告/可视化) 一律不入库
data/**
# !data/workspaces/
# data/workspaces/**
# !data/workspaces/*/
# !data/workspaces/*/anchor_tags.yaml
# !data/workspaces/*/tag_whitelist.yaml
# !data/workspaces/*/workspace_meta.yaml
# !data/workspaces/*/calibration/
# !data/workspaces/*/production/
# !data/workspaces/*/calibration/raw_images/
# !data/workspaces/*/calibration/raw_images/**
# !data/workspaces/*/production/raw_images/
# !data/workspaces/*/production/raw_images/**
*.npy
*.bag

# 大文件压缩包禁止入库（GitHub 100MB 限制）
*.rar
*.zip
*.7z

# IDE 与环境配置
.vscode/
.idea/
*.log

# 工具缓存
.ruff_cache/

# 临时调试与草稿目录 (禁止入库)
reports/
scratch/
temp/
tmp/
*.bak
